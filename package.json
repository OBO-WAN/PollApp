{
  "name": "poll-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run supabase:config && ng serve --o",
    "build": "ng build",
    "build:netcup": "npm run supabase:config && ng build --configuration production --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "supabase start && supabase db reset && playwright test --config=playwright.supabase.config.ts",
    "supabase:config": "node scripts/write-supabase-config.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:verify": "supabase start && supabase db reset && supabase test db",
    "format:check": "prettier --check . --ignore-unknown",
    "verify": "npm run format:check && npm test -- --watch=false && npm run build"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@supabase/supabase-js": "^2.112.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "supabase": "2.115.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
